# Copy this file to .env. No API key is needed for local Ollama or the demos.
# Never put a real API key in this example file or commit your .env file.
GEMINI_API_KEY=

# This is the project's default model ID. If unavailable to your Google
# project, replace it with an available Gemini model with function calling.
GEMINI_MODEL=gemini-3.8-flash

# Open http://127.0.0.1:3000 after starting the server.
PORT=3000

# true: show browser screenshots in the dashboard only.
# false: also open a separate visible browser window for the worker.
HEADLESS=true

# Multi-step tasks such as invoice processing need several model turns.
MAX_MODEL_TURNS=32
MAX_TOOL_CALLS=45
MAX_RUN_MINUTES=10

# workspace: file tools stay inside data/workspace/.
# all: allow paths anywhere your OS account permits, including ~/Documents.
# File writes and moves still require approval in either mode.
FILE_ACCESS=workspace

# Default dashboard mode: ollama, gemini, or demo.
AI_PROVIDER=demo

# Ollama must be running and the model downloaded: ollama pull qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_CONTEXT_SIZE=16384
